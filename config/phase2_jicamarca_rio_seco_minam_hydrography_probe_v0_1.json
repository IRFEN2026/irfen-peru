    "selection_requires_separate_frozen_identity_and_topology_review": true,
    "selection_must_not_use_event_outcomes": true,
    "selection_must_not_use_A6680": true,
    "selection_must_not_use_quarantined_qda_colca_as_rio_seco_geometry": true,
