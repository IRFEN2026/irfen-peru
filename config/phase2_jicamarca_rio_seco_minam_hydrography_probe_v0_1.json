    "expected_geometry_type": "esriGeometryPolyline",
    "service_spatial_reference_wkid": 32718,
    "source_role": "OFFICIAL_PUBLIC_HYDROGRAPHY_CANDIDATE_SOURCE_NOT_IDENTITY_AUTHORITY_BY_NAME_ALONE",
    "required_fields": [
      "OBJECTID_1",
      "objectid",
      "nombre",
      "tipo",
      "estado",
      "codigo",
      "zona",
      "text_tramo",
      "aaa",
      "nivel5",
      "nivel6",
      "nivel7",
      "id",
      "escala",
      "code_rio",
      "tipo_g",
      "r_q_text",
      "nomb_min",
      "fuente"
