{
  "schema_version": "0.1",
  "status": "PREREGISTERED_BOUNDED_OFFICIAL_IGN_HYDROGRAPHY_PROBE",
  "deployment_status": "RESEARCH_ONLY",
  "test_mode": "TEST_ONLY",
  "production_use": false,
  "production_ready": false,
  "operational_alerting_enabled": false,
  "activation_gate": "BLOCKED",
  "missing_data_rule": "UNKNOWN_NOT_LOW_RISK",
  "decision_thresholds": null,
  "hydraulic_factors": null,
  "system_id": "lima_este_jicamarca_huaycoloro_rioseco_canto_grande",
  "component_id": "rio_seco",
  "effective_discovery_contract": "config/phase2_jicamarca_discovery_v0_2.json",
  "evidence_index": "config/phase2_jicamarca_evidence_index_v0_6.json",
  "purpose": "Probe a second independent official public hydrography source for candidate Rio Seco natural-channel linework inside the published Jicamarca subbasin documentary bounds. Returned linework is candidate-only and cannot define the Rio Seco channel, catchment, outlet, confluence, routing, event footprint, threshold, risk state or alert until a separate frozen identity/topology review passes.",
  "source": {
    "institution": "Instituto Geografico Nacional del Peru",
    "publication_host": "Infraestructura de Datos Espaciales del Peru (IDEP)",
    "service_url": "https://www.idep.gob.pe/geoportal/rest/services/DATOS_ESPACIALES/TEMA_BASE/MapServer",
    "layer_id": 5,
    "expected_layer_name": "Corriente de Agua",
    "expected_geometry_type": "esriGeometryPolyline",
    "service_spatial_reference_wkid": 24878,
    "source_role": "OFFICIAL_BASE_HYDROGRAPHY_CANDIDATE_SOURCE_NOT_IDENTITY_AUTHORITY_BY_NAME_ALONE",
    "required_fields": [
      "OBJECTID_1",
      "NOMBRE",
      "CUENCA",
      "PROVINCIA",
      "DPTO",
      "DISTRITO",
      "COD_FACC",
      "COD_IGN"
    ]
  },
  "query_window": {
    "basis": "INDECI_2013_JICAMARCA_SUBBASIN_DOCUMENTARY_BOUNDS",
    "source_contract": "config/phase2_jicamarca_indeci2013_confluence_topology_v0_1.json",
    "source_document_url": "https://sigrid.cenepred.gob.pe/docs/PARA%20PUBLICAR/INDECI/PERD%20HUACHIPA%20Informe_2013.pdf",
    "west_lon": -76.95,
    "south_lat": -12.033333333333333,
    "east_lon": -76.66666666666667,
    "north_lat": -11.75,
    "input_spatial_reference_wkid": 4326,
    "buffer_applied": false,
    "role": "COARSE_DOCUMENTARY_DISCOVERY_WINDOW_ONLY_NOT_CATCHMENT_GEOMETRY"
  },
  "query": {
    "where": "(NOMBRE LIKE '%Seco%' OR NOMBRE LIKE '%SECO%' OR NOMBRE LIKE '%seco%')",
    "geometry_type": "esriGeometryEnvelope",
    "spatial_relation": "esriSpatialRelIntersects",
    "return_geometry": true,
    "output_spatial_reference_wkid": 4326,
    "max_candidate_features": 100,
    "max_response_bytes": 20000000
  },
  "candidate_policy": {
    "candidate_is_accepted_rio_seco_channel": false,
    "name_match_is_sufficient_identity": false,
    "documentary_window_is_catchment_geometry": false,
    "line_endpoint_is_outlet": false,
    "line_intersection_is_confluence_without_independent_topology_review": false,
    "line_length_may_define_travel_time": false,
    "candidate_may_define_Q_i_t": false,
    "candidate_may_define_attenuation": false,
    "candidate_may_define_hydraulic_capacity": false,
    "candidate_may_define_event_footprint": false,
    "candidate_may_enable_routing": false,
    "candidate_may_promote_parent_activation": false,
    "candidate_may_promote_rimac_overflow": false,
    "selection_requires_separate_frozen_identity_and_topology_review": true,
    "selection_must_not_use_event_outcomes": true,
    "selection_must_not_use_A6680": true,
    "selection_must_not_use_quarantined_qda_colca_as_rio_seco_geometry": true
  },
  "cross_source_constraints": {
    "rio_seco_must_remain_distinct_from_colca": true,
    "rio_seco_must_remain_distinct_from_huaycoloro": true,
    "synthetic_quebrada_jicamarca_unit_allowed": false,
    "candidate_must_be_compatible_with_documentary_huaycoloro_rio_seco_convergence_before_promotion": true,
    "exact_confluence_coordinate_is_resolved_by_this_probe": false,
    "jicamarca_to_rimac_receiver_relation_is_resolved_by_this_probe": false
  },
  "collector_coupling": {
    "receiver": "rimac_mainstem",
    "connectivity": "UNRESOLVED_NOT_ASSUMED",
    "outlet_or_confluence": null,
    "Q_i_t": null,
    "travel_time": null,
    "attenuation": null,
    "quality": "UNKNOWN",
    "routing_enabled": false,
    "tributary_activation_implies_receiver_overflow": false
  },
  "map_effect": {
    "candidate_geometry_may_be_published": false,
    "parent_geometry_created": false,
    "event_footprint_created": false,
    "risk_or_alert_symbology_allowed": false
  },
  "next_gate_if_candidates_exist": "Freeze exact source response bytes/SHA-256 and perform an outcome-independent identity/topology review against independent official Jicamarca evidence before accepting any Rio Seco channel geometry or deriving a DEM catchment/outlet.",
  "next_gate_if_no_unique_candidate": "Remain geometry-missing and continue with independent official hydrography or outcome-independent DEM/topology only after a reproducible outlet/control point is resolved."
}
